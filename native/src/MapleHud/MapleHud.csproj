<Project Sdk="Microsoft.NET.Sdk">
  <!--
    Windows용 오버레이 앱. Windows 10/11에 기본으로 들어 있는 .NET Framework 4.8을 써서 따로 설치할 것이 없다.
    UseWindowsForms 대신 참조를 직접 걸어서 리눅스에서도 빌드된다.
  -->
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>MapleHud</RootNamespace>
    <AssemblyName>MapleSchedulerHUD</AssemblyName>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <Product>Maple Scheduler HUD</Product>
    <Description>메이플스토리 스케줄러 HUD</Description>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies.net48" Version="1.0.3" PrivateAssets="all" />
    <PackageReference Include="SkiaSharp.NativeAssets.Win32" Version="4.152.1" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="../MapleHud.Core/MapleHud.Core.csproj" />
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
    <None Include="../../fonts/*.otf" Link="fonts/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="../../fonts/Pretendard-LICENSE.txt" Link="fonts/Pretendard-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- 64비트 Windows용 Skia 네이티브 라이브러리만 실행 파일 옆에 둔다 -->
  <Target Name="TidyNativeAssets" AfterTargets="Build">
    <Copy SourceFiles="$(OutDir)x64/libSkiaSharp.dll" DestinationFolder="$(OutDir)" Condition="Exists('$(OutDir)x64/libSkiaSharp.dll')" />
    <RemoveDir Directories="$(OutDir)x86;$(OutDir)arm64;$(OutDir)x64" />
    <Delete Files="$(OutDir)libSkiaSharp.dylib;$(OutDir)libSkiaSharp.so" />
  </Target>
</Project>
